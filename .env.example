SUPABASE_PUBLISHABLE_KEY=
PROJECT_OS_APP_URL=http://127.0.0.1:3001
PROJECT_OS_OWNER_EMAIL=danielduarcas@gmail.com
# Optional: pin the Supabase user UUID after creating the owner account.
PROJECT_OS_OWNER_ID=
# Docker production: true; never seed a new workspace automatically.
PROJECT_OS_REQUIRE_EXISTING_WORKSPACE=false
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PROJECT_OS_AI_DAILY_LIMIT=40
PROJECT_OS_AI_CONTEXT_ENABLED=false

# GBrain machine credential: server only, no owner/admin token or OpenAI key.
GBRAIN_URL=https://brain.brant--co.com
GBRAIN_SOURCE_ID=project-os
GBRAIN_CLIENT_ID=
GBRAIN_CLIENT_SECRET=
PROJECT_OS_BRAIN_ENABLED=false
PROJECT_OS_BRAIN_DAILY_LIMIT=30

# GitHub App dedicated to Project OS; server only, runtime secrets.
# Contents: read-only; Metadata: read-only; no write permissions.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM as a quoted value with escaped \n, or a multiline runtime secret.
GITHUB_APP_PRIVATE_KEY=
# Comma-separated account/organization logins allowed in this owner's workspace.
GITHUB_ALLOWED_ACCOUNTS=DuarCas-maker
